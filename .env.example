PORT=3000
HOST=0.0.0.0
MCP_PATH=/mcp

# none | bearer
AUTH_MODE=none
MCP_BEARER_TOKEN=
PUBLIC_BASE_URL=

# Profile-scoped generic storage
MCP_PROFILES_FILE=./data/profiles.json
MCP_WORKSPACE_ROOT=./data/workspaces
MCP_MAX_RECORD_BYTES=1048576

# file | remote
CONTENT_SOURCE=file
CONTENT_FILE=./data/content.json
CONTENT_REMOTE_URL=
CONTENT_REMOTE_BEARER_TOKEN=
CONTENT_CACHE_TTL_SECONDS=60

# file | postgres
LEDGER_DRIVER=file
LEDGER_FILE=./data/ledger.json
DATABASE_URL=
LEDGER_TABLE=grok_mcp_events
